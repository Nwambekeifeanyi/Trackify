<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trackify - Architecture Hub</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --color-bg-light: #f8fafc;
            --color-bg-card: #ffffff;
            --color-primary: #10b981;
            --color-secondary: #4f46e5;
            --color-text-main: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--color-bg-light);
            color: var(--color-text-main);
        }

        /* Custom Scrollbar configuration for sub-containers */
        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="h-screen flex overflow-hidden bg-slate-50">

    <% var context %>
    <!-- ================================== narvbar ============================================= -->
 <!-- nav bar -->
    <%- include('../snippets/navbar.ejs') %>
    <div class="flex-grow flex flex-col h-full overflow-hidden">
        
        <!-- DASHBOARD ACTION GLOBAL TOPBAR -->
          <%- include('../snippets/topbar.ejs') %>

        <main class="flex-grow p-6 overflow-y-auto custom-scrollbar space-y-6">
            
           <% if (context.this_user) { %>
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <div class="p-4 bg-white border border-slate-200/80 rounded-xl shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Total Allocation</p>
                <h3 class="text-xl font-extrabold text-slate-900 tracking-tight mt-0.5">
                    ₦<%= Number(context.this_user.income || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </h3>
                <span class="text-[10px] text-emerald-500 font-bold"><i class="fa-solid fa-arrow-up-long"></i> +12.4% This cycle</span>
            </div>
            <div class="p-3 bg-emerald-50 rounded-xl text-emerald-500"><i class="fa-solid fa-building-columns text-base"></i></div>
        </div>
        
        <div class="p-4 bg-white border border-slate-200/80 rounded-xl shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Spent Overhead</p>
                <h3 class="text-xl font-extrabold text-slate-900 tracking-tight mt-0.5">
                    ₦<%= Number(context.this_user.expenditure || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </h3>
                <span class="text-[10px] text-indigo-500 font-bold">
                    <i class="fa-solid fa-chart-line"></i> 
                    <%= context.this_user.income > 0 ? ((context.this_user.expenditure / context.this_user.income) * 100).toFixed(1) : 0 %>% Burn rate
                </span>
            </div>
            <div class="p-3 bg-indigo-50 rounded-xl text-indigo-500"><i class="fa-solid fa-money-bill-transfer text-base"></i></div>
        </div>
        
        <div class="p-4 bg-white border border-slate-200/80 rounded-xl shadow-sm flex items-center justify-between">
            <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wide">Remaining Float</p>
                <h3 class="text-xl font-extrabold text-slate-900 tracking-tight mt-0.5">
                    ₦<%= Number(context.this_user.balance || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
                </h3>
                <span class="text-[10px] text-slate-500 font-bold"><i class="fa-solid fa-shield-halved"></i> Stable configuration</span>
            </div>
            <div class="p-3 bg-slate-100 rounded-xl text-slate-600"><i class="fa-solid fa-vault text-base"></i></div>
        </div>
        
    </section>
<% } %>

            <section class="grid grid-cols-1 lg:grid-cols-5 gap-6">
                
                <% 
  // Map internal database category keys to UI presentation models
  const categoryConfigs = {
     'academic': { title: 'Academic, Research & Training', icon: 'fa-book', baseColor: 'indigo' },
     'subsistence': { title: 'Food & Subsistence Utilities', icon: 'fa-burger', baseColor: 'amber' },
     'infrastructure': { title: 'Network & Infrastructure Labs', icon: 'fa-wifi', baseColor: 'emerald' },
     'housing & rent': { title: 'Housing & Workspace Leases', icon: 'fa-house-chimney', baseColor: 'purple' },
     'utilities': { title: 'Power, Water & Public Utilities', icon: 'fa-bolt', baseColor: 'orange' },
     'logistics': { title: 'Logistics & Transportation', icon: 'fa-car', baseColor: 'blue' },
     'healthcare': { title: 'Medical, Wellness & Insurance', icon: 'fa-heart-pulse', baseColor: 'rose' },
     'marketing': { title: 'Marketing, Ads & Client Outreach', icon: 'fa-rectangle-ad', baseColor: 'lightBlue' },
     'legal & taxes': { title: 'Taxes, Levies & Legal Overhead', icon: 'fa-scale-balanced', baseColor: 'violet' },
     'other': { title: 'Miscellaneous Overhead', icon: 'fa-tags', baseColor: 'slate' }
  };

  // Determine if any category has exceeded safe parameters (> 85% spent)
  let systemCapWarningActive = false;
  if (context.budgets && context.budgets.length > 0) {
     systemCapWarningActive = context.budgets.some(b => ((b.spent / b.limit) * 100) >= 85);
  }
%>

<div class="lg:col-span-3 p-5 bg-white border border-slate-200/80 rounded-xl shadow-sm flex flex-col justify-between h-80">
    
    <div class="mb-2">
        <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Active Budget Thresholds</h3>
            
            <% if (systemCapWarningActive) { %>
                <span class="text-[9px] bg-rose-50 text-rose-600 border border-rose-200 px-2 py-0.5 rounded-md font-bold uppercase tracking-wide animate-pulse">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i> Cap Warnings Active
                </span>
            <% } else { %>
                <span class="text-[9px] bg-emerald-50 text-emerald-600 border border-emerald-200 px-2 py-0.5 rounded-md font-bold uppercase tracking-wide">
                    <i class="fa-solid fa-circle-check mr-1"></i> Limits Stable
                </span>
            <% } %>
        </div>
        <p class="text-[11px] text-slate-400">Current allocation ceilings vs realistic resource drain</p>
    </div>

    <div class="flex-grow overflow-y-auto custom-scrollbar space-y-4 pr-1 mt-2">
        
        <% context.budgets.forEach(budget => { 
            const config = categoryConfigs[budget.category] || { title: budget.category, icon: 'fa-tags', baseColor: 'slate' };
            const spent = budget.spent;
            const limit = budget.limit;
            let percent = Math.min(((spent / limit) * 100), 100);
            
            // Adjust colors based on percentage spent thresholds
            let statusColor = config.baseColor;
            if (percent >= 90) statusColor = 'rose';
            else if (percent >= 75) statusColor = 'amber';
        %>
            <div class="space-y-1.5">
                <div class="flex justify-between items-center text-xs">
                    <span class="font-bold text-slate-700 flex items-center gap-1.5">
                        <i class="fa-solid <%= config.icon %> text-<%= statusColor %>-500 text-[10px]"></i> 
                        <%= config.title %>
                    </span>
                    
                    <% if (percent >= 85) { %>
                        <span class="text-<%= statusColor %>-600 font-bold">
                            <i class="fa-solid fa-circle-exclamation mr-0.5"></i> 
                            ₦<%= spent.toLocaleString('en-NG') %> 
                            <span class="text-slate-400 font-normal">/ ₦<%= limit.toLocaleString('en-NG') %></span>
                        </span>
                    <% } else { %>
                        <span class="text-slate-500 font-medium">
                            <span class="text-slate-900 font-bold">₦<%= spent.toLocaleString('en-NG') %></span> 
                            / ₦<%= limit.toLocaleString('en-NG') %>
                        </span>
                    <% } %>
                </div>
                
                <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                    <div class="bg-<%= statusColor %>-500 h-full rounded-full transition-all duration-500" 
                         style="width: <%= percent.toFixed(1) %>%"></div>
                </div>
            </div>
        <% }); %>

    </div>
</div>

                <div class="lg:col-span-2 p-5 bg-white border border-slate-200/80 rounded-xl shadow-sm flex flex-col justify-between h-80">
                    <div class="mb-3">
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Recent Ledger Logs</h3>
                        <p class="text-[11px] text-slate-400">Latest structural changes written to database</p>
                    </div>

                    <div class="flex-grow overflow-y-auto custom-scrollbar space-y-2.5 pr-1">

                        <% if (context.recents) { %>

                            <% context.recents.forEach(recent => { %>
                                <div class="flex items-center justify-between p-2 rounded-lg bg-slate-50/80 border border-slate-100">
                                    <div class="flex items-center gap-2.5">
                                        <div class="w-7 h-7 rounded-lg flex items-center justify-center text-xs 
    <%= recent.type === 'expense' ? 'bg-rose-50 text-rose-500' : 
        recent.type === 'campus' ? 'bg-indigo-50 text-indigo-500' : 
        'bg-emerald-50 text-emerald-500' %>">
        
    <% if (recent.type === 'expense') { %>
        <i class="fa-solid fa-receipt text-sm"></i>
    <% } else if (recent.type === 'campus') { %>
        <i class="fa-solid fa-graduation-cap text-sm"></i>
    <% } else { %>
        <i class="fa-solid fa-wallet text-sm"></i>
    <% } %>
</div>
                                        <div>
                                            <h5 class="text-xs font-bold text-slate-800 leading-none capitalize"><%= recent.source %></h5>
                                            <span class="text-[9px] text-slate-400 font-medium"><%= recent.category ==='not assigned'? recent.session : recent.category%></span>
                                        </div>
                                    </div>
                                    <span class="text-xs font-bold text-slate-900">
    <%= (recent.type === 'expense' || recent.type === 'campus') ? '-' : '' %>₦<%= recent.amount.toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
</span>
                                </div>
                             
                            <% }) %>
                         
                        <% } %>
                      
                    </div>
                </div>
            </section>
        </main>

        <footer class="h-10 border-t border-slate-200/80 bg-white px-6 flex items-center justify-between text-slate-400 text-[10px] shrink-0">
            <p>&copy; 2026 Trackify Workspace Layer.</p>
            <p class="font-medium">System Version: v2.1.0-prod</p>
        </footer>
    </div>

    <script src="/js/toggle_nav.js"></script>
</body>
</html>