            <th class="py-3 px-5">Session/Category</th>
            <th class="py-3 px-5">Status Mappings</th>
            <th class="py-3 px-5 text-right">Invoice Sum</th>
            <th class="py-3 px-5 text-center">Receipt</th>
        </tr>
    </thead>
   <tbody id="ledger-table-body" class="divide-y divide-slate-100 text-xs text-slate-700">
    <tr class="ledger-row hover:bg-slate-50/50 transition-colors" data-status="CLEARED">
        <td class="py-3.5 px-5 font-bold text-slate-800">Session Tuition Installment I</td>
        <td class="py-3.5 px-5 text-slate-400 font-semibold">2025/2026 Academic</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-md font-bold text-[9px] uppercase tracking-wider">Cleared</span>
        </td>
        <td class="py-3.5 px-5 text-right font-extrabold text-slate-900">₦80,000.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
    <tr class="ledger-row hover:bg-slate-50/50 transition-colors" data-status="CLEARED">
        <td class="py-3.5 px-5 font-bold text-slate-800">Departmental & Lab Insurance Dues</td>
        <td class="py-3.5 px-5 text-slate-400 font-semibold">Faculty Allocation</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-md font-bold text-[9px] uppercase tracking-wider">Cleared</span>
        </td>
        <td class="py-3.5 px-5 text-right font-extrabold text-slate-900">₦30,000.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
    <tr class="ledger-row hover:bg-slate-50/50 transition-colors" data-status="PENDING">
        <td class="py-3.5 px-5 font-bold text-slate-800">Student Union Government Levy</td>
        <td class="py-3.5 px-5 text-slate-400 font-semibold">Institutional Mandatory</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-amber-50 text-amber-600 rounded-md font-bold text-[9px] uppercase tracking-wider">Pending</span>
        </td>
        <td class="py-3.5 px-5 text-right font-extrabold text-rose-600">₦35,000.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
</tbody>
</table>
                </div>

                <div id="empty-ledger-fallback" class="hidden py-12 text-center text-slate-400 text-xs font-medium">
                    <i class="fa-solid fa-graduation-cap text-xl mb-2 text-slate-300 block"></i>
                    No institutional invoices fit the specified filters.
                </div>
            </section>
        </main>

        <footer class="h-10 border-t border-slate-200/80 bg-white px-6 flex items-center justify-between text-slate-400 text-[10px] shrink-0">
            <p>&copy; <%= new Date().getFullYear() %> Trackify Workspace Layer.</p>
            <p class="font-medium">System Version: v2.1.0-prod</p>
        </footer>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("ledger-search-input");
            const statusFilter = document.getElementById("ledger-status-filter");
            const rows = document.querySelectorAll(".ledger-row");
            const fallbackElement = document.getElementById("empty-ledger-fallback");

            function filterLedgerEngine() {
                const query = searchInput.value.toLowerCase().trim();
                const selectedStatus = statusFilter.value;
                let activeMatches = 0;

                rows.forEach(row => {
                    const rowText = row.cells[0].textContent.toLowerCase();
                    const statusType = row.getAttribute("data-status");

                    const matchesQuery = rowText.includes(query);
                    const matchesStatus = (selectedStatus === "ALL" || statusType === selectedStatus);

                    if (matchesQuery && matchesStatus) {
                        row.style.display = "";
                        activeMatches++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (activeMatches === 0) {
                    fallbackElement.classList.remove("hidden");
                } else {
                    fallbackElement.classList.add("hidden");
                }
            }

            searchInput.addEventListener("input", filterLedgerEngine);
            statusFilter.addEventListener("change", filterLedgerEngine);
        });

        function triggerInvoiceSettlement() {
            alert('Campus Ledger Invoice Settlement Frame Dispatched.');
        }
    </script>
    <script src="/js/toggle_nav.js"></script>
