<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trackify - Log New Expense</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --color-bg-light: #f8fafc;
            --color-bg-card: #ffffff;
            --color-primary: #10b981;
            --color-secondary: #4f46e5;
            --color-text-main: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--color-bg-light);
            color: var(--color-text-main);
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
    </style>
</head>
<body class="h-screen flex overflow-hidden bg-slate-50">

    <!-- SIDEBAR COMPONENT LINK -->
    <%- include('../snippets/navbar.ejs') %>
    
    <div class="flex-grow flex flex-col h-full overflow-hidden">
        
        <!-- GLOBAL TOPBAR LINK -->
        <%- include('../snippets/topbar.ejs') %>

        <!-- MAIN APP FRAME CONTAINER -->
        <main class="flex-grow p-6 overflow-y-auto custom-scrollbar">

            <div id="formToast" class="fixed top-10 left-1/2 -translate-x-1/2 z-[10000] transform -translate-y-20 opacity-0 transition-all duration-500 pointer-events-none">
        <div class="bg-white border-l-4 border-red-500 shadow-2xl rounded-xl p-4 flex items-center space-x-4 min-w-[320px]">
            <div id="toastIconBg" class="w-10 h-10 rounded-full flex items-center justify-center flex-shrink-0">
                <i id="toastIcon" class="fas fa-exclamation-triangle text-white"></i>
            </div>
            <div class="flex-1">
                <p id="toastTitle" class="text-[10px] font-black uppercase tracking-widest text-slate-400 mb-0.5">System Alert</p>
                <p id="toastMessage" class="text-sm font-bold text-slate-800">Invalid Input Detected</p>
            </div>
            <button onclick="appNotify.hide()" class="text-slate-300 hover:text-slate-600 transition">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>


            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start max-w-6xl mx-auto">
                
                <!-- PRIMARY TRANSACTION FORM COMPONENT -->
                <section class="bg-white border border-slate-200/80 rounded-xl shadow-sm lg:col-span-3 overflow-hidden">
                    <div class="px-6 py-4 border-b border-slate-100 bg-slate-50/50">
                        <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Register Expense Ledger Entry</h3>
                        <p class="text-[11px] text-slate-400">Log resource exhaustion and payments against allocated category ceilings</p>
                    </div>

                    <!-- Post route hooked directly to data ingestion architecture -->
                    <form id="form" class="p-6 space-y-4">
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Expense Destination / Vendor Input Field -->
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Vendor / Expense Destination</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400"><i class="fa-solid fa-store text-xs"></i></span>
                                    <input type="text" name="source" placeholder="e.g. Housing, Logistics, Healthcare..." class="w-full pl-9 pr-4 py-2 text-xs border border-slate-200 rounded-lg font-medium text-slate-700 bg-slate-50/30 focus:outline-hidden focus:border-rose-500/50 focus:bg-white transition-all">
                                </div>
                            </div>

                            <!-- Financial Amount Field -->
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Debit Amount (NGN)</label>
                                <div class="relative">
                                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-500 font-extrabold text-xs">₦</span>
                                    <input type="number" step="0.01" name="amount" placeholder="0.00" class="w-full pl-8 pr-4 py-2 text-xs border border-slate-200 rounded-lg font-bold text-slate-800 bg-slate-50/30 focus:outline-hidden focus:border-rose-500/50 focus:bg-white transition-all">
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <!-- Budget Ceiling Pool Dropdown -->
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Target Budget Pool</label>
                                <select name="category" class="w-full px-3 py-2 text-xs border border-slate-200 rounded-lg font-bold text-slate-600 bg-slate-50/30 focus:outline-hidden cursor-pointer">
        <option value="" disabled selected>Select Expense Category</option>
        
        <option value="Academic">Academic, Research & Training</option>
        
        <option value="Subsistence">Food & Subsistence Utilities</option>
        
        <option value="Infrastructure">Network & Infrastructure Labs</option>
        
        <option value="Housing & Rent">Housing & Workspace Leases</option>
        
        <option value="Utilities">Power, Water & Public Utilities</option>
        
        <option value="Logistics">Logistics & Transportation</option>
        
        <option value="Healthcare">Medical, Wellness & Insurance</option>
        
        <option value="Marketing">Marketing, Ads & Client Outreach</option>
        
        <option value="Legal & Taxes">Taxes, Levies & Legal Overhead</option>
        
        <option value="Other">Miscellaneous Overhead</option>
    </select>
                            </div>

                            <!-- Value Tracking Date Entry System -->
                            <div class="space-y-1">
                                <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Posting Date</label>
                                <div class="relative">
                                    <input type="date" name="date" value="<%= new Date().toISOString().split('T')[0] %>" class="w-full px-3 py-2 text-xs border border-slate-200 rounded-lg font-bold text-slate-600 bg-slate-50/30 focus:outline-hidden transition-all">
                                </div>
                            </div>
                        </div>

                        <!-- Descriptive Memo Log Area -->
                        <div class="space-y-1">
                            <label class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Structural Memo / Reference Notes</label>
                            <textarea name="description" rows="3" placeholder="Provide extra details concerning item specifications, receipt numbers, or project tracking parameters..." class="w-full p-3 text-xs border border-slate-200 rounded-lg font-medium text-slate-700 bg-slate-50/30 focus:outline-hidden focus:border-rose-500/50 focus:bg-white transition-all resize-none"></textarea>
                        </div>

                        <!-- Action Execution Buttons Footer Block -->
                        <div class="pt-2 border-t border-slate-100 flex items-center justify-end gap-2.5">
                            <a href="/expenses" class="px-4 py-2 border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 font-bold text-xs rounded-lg transition-all">Cancel</a>
                            <button type="submit" class="bg-[#e11d48] hover:bg-[#be123c] text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center gap-1.5 shadow-xs cursor-pointer">
                                <i class="fa-solid fa-cloud-arrow-up"></i> Commit Expense
                            </button>
                        </div>
                    </form>
                </section>

                <!-- QUICK NAVIGATION LINKS SUB-PANEL -->
                <aside class="space-y-4 lg:col-span-1">
                    <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-sm">
                        <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider mb-3">Transaction Modality Router</h4>
                        <div class="flex flex-col gap-2">
                            
                            <!-- Add Income Link -->
                            <a href="add-income" class="flex items-center justify-between p-2.5 rounded-lg border border-slate-100 hover:border-emerald-100 hover:bg-emerald-50/40 group transition-all">
                                <span class="text-xs font-semibold text-slate-600 group-hover:text-emerald-600 group-hover:font-bold flex items-center gap-2 transition-colors">
                                    <i class="fa-solid fa-circle-plus text-xs text-slate-400 group-hover:text-emerald-500"></i> Add Income
                                </span>
                                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-emerald-400 group-hover:translate-x-0.5 transition-transform"></i>
                            </a>

                            <!-- Add Expense Link (Active State Marker) -->
                            <a href="add-expenses" class="flex items-center justify-between p-2.5 rounded-lg border border-rose-100 bg-rose-50/60 group transition-all">
                                <span class="text-xs font-bold text-rose-600 flex items-center gap-2">
                                    <i class="fa-solid fa-circle-minus text-xs"></i> Add Expense
                                </span>
                                <i class="fa-solid fa-chevron-right text-[10px] text-rose-400 group-hover:translate-x-0.5 transition-transform"></i>
                            </a>

                            <!-- Add Campus Ledger Link -->
                            <a href="add-campus-ledger" class="flex items-center justify-between p-2.5 rounded-lg border border-slate-100 hover:border-indigo-100 hover:bg-indigo-50/40 group transition-all">
                                <span class="text-xs font-semibold text-slate-600 group-hover:text-indigo-600 group-hover:font-bold flex items-center gap-2 transition-colors">
                                    <i class="fa-solid fa-graduation-cap text-xs text-slate-400 group-hover:text-indigo-500"></i> Add Campus Ledger
                                </span>
                                <i class="fa-solid fa-chevron-right text-[10px] text-slate-300 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-transform"></i>
                            </a>

                        </div>
                    </div>
                </aside>

            </div>
        </main>

        <!-- GLOBAL SYSTEM FOOTER -->
        <footer class="h-10 border-t border-slate-200/80 bg-white px-6 flex items-center justify-between text-slate-400 text-[10px] shrink-0">
            <p>&copy; <%= new Date().getFullYear() %> Trackify Workspace Layer.</p>
            <p class="font-medium">System Version: v2.1.0-prod</p>
        </footer>
    </div>
    <script src="/js/toggle_nav.js"></script>
    <script src="/formHandlers/user/add-expenses.js"></script>
</body>
</html>