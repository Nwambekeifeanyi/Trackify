<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trackify - Income Receipt</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --color-bg-light: #f8fafc;
            --color-bg-card: #ffffff;
            --color-primary: #10b981;
            --color-secondary: #4f46e5;
            --color-text-main: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--color-bg-light);
            color: var(--color-text-main);
        }

        /* Print Override Layout Matrix */
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-voucher, #printable-voucher * {
                visibility: visible;
            }
            #printable-voucher {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                border: none !important;
                box-shadow: none !important;
                padding: 0 !important;
            }
            .no-print {
                display: none !important;
            }
        }
    </style>
</head>
<body class="h-screen flex overflow-hidden bg-slate-50">

    <div class="no-print">
        <%- include('../snippets/navbar.ejs') %>
    </div>
    
    <div class="flex-grow flex flex-col h-full overflow-hidden">
        
        <div class="no-print">
            <%- include('../snippets/topbar.ejs') %>
        </div>

        <main class="flex-grow p-6 flex items-center justify-center overflow-hidden">
            <!-- income receipt -->
            <% if (context.transaction) { %>
                
                <% if (context.transaction.type === 'income') { %>
                    <div class="grid grid-cols-1 md:grid-cols-5 gap-6 max-w-4xl w-full items-stretch">
                        
                        <section id="printable-voucher" class="md:col-span-3 bg-white border border-slate-200/80 rounded-xl shadow-xs p-6 flex flex-col justify-between relative overflow-hidden bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:16px_16px]">
                            
                            <div class="absolute top-0 left-0 right-0 h-1 bg-emerald-500"></div>
        
                            <div>
                                <div class="flex items-start justify-between border-b border-slate-100 pb-4">
                                    <div>
                                        <h2 class="text-sm font-extrabold text-slate-900 tracking-tight flex items-center gap-1.5">
                                            <i class="fa-solid fa-square-poll-horizontal text-emerald-500"></i> Trackify Layer
                                        </h2>
                                        <p class="text-[10px] text-slate-400 font-medium mt-0.5">Transaction Voucher Account</p>
                                    </div>
                                    <div class="text-right">
                                        <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-md font-bold text-[9px] uppercase tracking-wider">
                                            INCOME
                                        </span>
                                        <p class="text-[9px] text-slate-400 font-bold mt-1">REF: TRK-<%= String(context.transaction._id).slice(-6).toUpperCase() %></p>
                                    </div>
                                </div>
        
                                <div class="mt-5 space-y-3.5">
                                    <div>
                                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Source / Issuing Entity</span>
                                        <span class="text-xs font-bold text-slate-800 capitalize"><%= context.transaction.source %></span>
                                    </div>
        
                                    <div class="grid grid-cols-2 gap-4">
                                        <div>
                                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Classification Pool</span>
                                            <span class="inline-flex items-center px-2 py-0.5 mt-0.5 rounded-sm text-[10px] font-semibold bg-indigo-50 text-indigo-600">
                                                <%= context.transaction.category %>
                                            </span>
                                        </div>
                                        <div>
                                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Posting Date</span>
                                            <span class="text-xs font-bold text-slate-700"><%= new Date(context.transaction.regDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                                        </div>
                                    </div>
        
                                    <div class="p-2.5 bg-slate-50 border border-slate-100 rounded-lg">
                                        <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Memo / Reference Notes</span>
                                        <p class="text-[11px] text-slate-600 leading-relaxed font-medium"><%= context.transaction.description || 'No descriptive structural notes assigned to this ledger record.' %></p>
                                    </div>
                                </div>
                            </div>
        
                            <div class="mt-6 pt-4 border-t border-dashed border-slate-200 flex items-center justify-between">
                                <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Net Remittance Inflow</span>
                                <span class="text-lg font-black text-slate-900 tracking-tight">
                                    ₦<%= context.transaction.amount.toLocaleString() %>
                                </span>
                            </div>
        
                        </section>
        
                        <section class="md:col-span-2 flex flex-col justify-between gap-4 no-print">
                            
                            <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-3.5 flex-grow">
                                <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">System Validation Log</h4>
                                
                                <div class="space-y-2.5 text-[11px] text-slate-600 font-medium">
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-shield-halved text-slate-400 text-xs w-4"></i>
                                        <span>Status: <strong class="text-emerald-600">Verified Ledger Ingestion</strong></span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-server text-slate-400 text-xs w-4"></i>
                                        <span>Engine: <span class="text-slate-800 font-bold">Trackify Finance Cluster</span></span>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <i class="fa-solid fa-fingerprint text-slate-400 text-xs w-4"></i>
                                        <span class="truncate">Hash: <span class="font-mono text-slate-500 text-[10px]"><%= String(context.transaction._id).slice(0,6).toUpperCase() %></span></span>
                                    </div>
                                </div>
                            </div>
        
                            <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-2">
                                <!-- <button onclick="window.print()" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center justify-center gap-1.5 shadow-xs cursor-pointer">
                                    <i class="fa-solid fa-print"></i> Print Voucher
                                </button>
                                 -->
                               <a href="income-logs" class="w-full bg-[#10b981] text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center justify-center gap-1.5">
            <i class="fa-solid fa-arrow-left"></i> Return to Logs
        </a>
                            </div>
        
                        </section>
        
                    </div>
                 
                <% } %>
            <% } %>


             <!-- expense receipt -->
            <% if (context.transaction) { %>
                
    <% if (context.transaction.type === 'expense') { %>
        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 max-w-4xl w-full items-stretch">
            
            <section id="printable-voucher" class="md:col-span-3 bg-white border border-slate-200/80 rounded-xl shadow-xs p-6 flex flex-col justify-between relative overflow-hidden bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:16px_16px]">
                
                <div class="absolute top-0 left-0 right-0 h-1 bg-rose-500"></div>
        
                <div>
                    <div class="flex items-start justify-between border-b border-slate-100 pb-4">
                        <div>
                            <h2 class="text-sm font-extrabold text-slate-900 tracking-tight flex items-center gap-1.5">
                                <i class="fa-solid fa-square-poll-horizontal text-rose-500"></i> Trackify Layer
                            </h2>
                            <p class="text-[10px] text-slate-400 font-medium mt-0.5">Expense Voucher Account</p>
                        </div>
                        <div class="text-right">
                            <span class="px-2 py-0.5 bg-rose-50 text-rose-600 rounded-md font-bold text-[9px] uppercase tracking-wider">
                               EXPENSE
                            </span>
                            <p class="text-[9px] text-slate-400 font-bold mt-1">REF: EXP-<%= String(context.transaction._id).slice(-6).toUpperCase() %></p>
                        </div>
                    </div>
        
                    <div class="mt-5 space-y-3.5">
                        <div>
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Vendor / Service Provider</span>
                            <span class="text-xs font-bold text-slate-800 capitalize"><%= context.transaction.source %></span>
                        </div>
        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Expense Category Pool</span>
                                <span class="inline-flex items-center px-2 py-0.5 mt-0.5 rounded-sm text-[10px] font-semibold bg-rose-50 text-rose-600 capitalize">
                                    <%= context.transaction.category %>
                                </span>
                            </div>
                            <div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Posting Date</span>
                                <span class="text-xs font-bold text-slate-700"><%= new Date(context.transaction.regDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                            </div>
                        </div>
        
                        <div class="p-2.5 bg-slate-50 border border-slate-100 rounded-lg">
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">Memo / Structural Notes</span>
                            <p class="text-[11px] text-slate-600 leading-relaxed font-medium"><%= context.transaction.description || 'No descriptive structural notes assigned to this ledger record.' %></p>
                        </div>
                    </div>
                </div>
        
                <div class="mt-6 pt-4 border-t border-dashed border-slate-200 flex items-center justify-between">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Net Outflow Debit</span>
                    <span class="text-lg font-black text-rose-600 tracking-tight">
                        -₦<%= context.transaction.amount.toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                    </span>
                </div>
        
            </section>
        
            <section class="md:col-span-2 flex flex-col justify-between gap-4 no-print">
                
                <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-3.5 flex-grow">
                    <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">System Validation Log</h4>
                    
                    <div class="space-y-2.5 text-[11px] text-slate-600 font-medium">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-slate-400 text-xs w-4"></i>
                            <span>Status: <strong class="text-rose-600">Verified Ledger Ingestion</strong></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-server text-slate-400 text-xs w-4"></i>
                            <span>Engine: <span class="text-slate-800 font-bold">Trackify Finance Cluster</span></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-fingerprint text-slate-400 text-xs w-4"></i>
                            <span class="truncate">Hash: <span class="font-mono text-slate-500 text-[10px]"><%= String(context.transaction._id).slice(0,8).toUpperCase() %></span></span>
                        </div>
                    </div>
                </div>
        
                <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-2">
                    <a href="expense-logs" class="w-full bg-[#10b981] text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center justify-center gap-1.5">
                        <i class="fa-solid fa-arrow-left"></i> Return to Logs
                    </a>
                </div>
        
            </section>
        
        </div>
    <% } %>
<% } %>

           <!-- campus ledger -->
            <% if (context.transaction) { %>
             
    <% if (context.transaction.type === 'campus') { %>
         
        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 max-w-4xl w-full items-stretch">
                
            <section id="printable-voucher" class="md:col-span-3 bg-white border border-slate-200/80 rounded-xl shadow-xs p-6 flex flex-col justify-between relative overflow-hidden bg-[radial-gradient(#e2e8f0_1px,transparent_1px)] [background-size:16px_16px]">
                
                <div class="absolute top-0 left-0 right-0 h-1 <%= context.transaction.status === 'CLEARED' ? 'bg-emerald-500' : 'bg-amber-500' %>"></div>
        
                <div>
                    <div class="flex items-start justify-between border-b border-slate-100 pb-4">
                        <div>
                            <h2 class="text-sm font-extrabold text-slate-900 tracking-tight flex items-center gap-1.5">
                                <i class="fa-solid fa-graduation-cap text-indigo-600"></i> Campus Portal Layer
                            </h2>
                            <p class="text-[10px] text-slate-400 font-medium mt-0.5">Official Student Ledger Statement</p>
                        </div>
                        <div class="text-right">
                            <span class="px-2 py-0.5 rounded-md font-bold text-[9px] uppercase tracking-wider <%= context.transaction.status === 'CLEARED' ? 'bg-emerald-50 text-emerald-600' : 'bg-amber-50 text-amber-600' %>">
                                <%= context.transaction.status === 'CLEARED' ? 'Cleared' : 'Pending' %>
                            </span>
                            <p class="text-[9px] text-slate-400 font-bold mt-1">REF: LDG-<%= String(context.transaction._id).slice(-6).toUpperCase() %></p>
                        </div>
                    </div>
        
                    <div class="mt-5 space-y-3.5">
                        <div>
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Fee Description</span>
                            <span class="text-xs font-bold text-slate-800 capitalize"><%= context.transaction.source %></span>
                        </div>
        
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Session / Category</span>
                                <span class="inline-flex items-center px-2 py-0.5 mt-0.5 rounded-sm text-[10px] font-semibold bg-indigo-50 text-indigo-600">
                                    <%= context.transaction.session %> Academic
                                </span>
                            </div>
                            <div>
                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block">Clearance Date</span>
                                <span class="text-xs font-bold text-slate-700"><%= new Date(context.transaction.regDate).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %></span>
                            </div>
                        </div>
        
                        <div class="p-2.5 bg-slate-50 border border-slate-100 rounded-lg">
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider block mb-0.5">System Memo / Reference Notes</span>
                            <p class="text-[11px] text-slate-600 leading-relaxed font-medium"><%= context.transaction.description || 'No supplementary reference notes provided for this campus record entry.' %></p>
                        </div>
                    </div>
                </div>
        
                <div class="mt-6 pt-4 border-t border-dashed border-slate-200 flex items-center justify-between">
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wide">Remitted Invoice Sum</span>
                    <span class="text-lg font-black text-slate-900 tracking-tight">
                        ₦<%= context.transaction.amount.toLocaleString('en-NG', { minimumFractionDigits: 2 }) %>
                    </span>
                </div>
        
            </section>
        
            <section class="md:col-span-2 flex flex-col justify-between gap-4 no-print">
                
                <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-3.5 flex-grow">
                    <h4 class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Bursary Validation Log</h4>
                    
                    <div class="space-y-2.5 text-[11px] text-slate-600 font-medium">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-shield-halved text-slate-400 text-xs w-4"></i>
                            <span>Status: 
                                <strong class="<%= context.transaction.status === 'CLEARED' ? 'text-emerald-600' : 'text-amber-600' %>">
                                    <%= context.transaction.status === 'CLEARED' ? 'Settled & Verified' : 'Outstanding Liability' %>
                                </strong>
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-server text-slate-400 text-xs w-4"></i>
                            <span>Channel: <span class="text-slate-800 font-bold">Campus Gateway V3</span></span>
                        </div>
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-fingerprint text-slate-400 text-xs w-4"></i>
                            <span class="truncate">Token: <span class="font-mono text-slate-500 text-[10px]"><%= String(context.transaction._id).slice(0,8).toUpperCase() %></span></span>
                        </div>
                    </div>
                </div>
        
                <div class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-xs space-y-2">
                    <a href="campus-ledger" class="w-full bg-[#10b981] hover:bg-[#059669] text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center justify-center gap-1.5 shadow-xs">
                        <i class="fa-solid fa-arrow-left"></i> Return to Campus Ledger
                    </a>
                </div>
        
            </section>
        
        </div>
    <% } %>
<% } %>
        </main>

        <footer class="h-10 border-t border-slate-200/80 bg-white px-6 flex items-center justify-between text-slate-400 text-[10px] shrink-0 no-print">
            <p>&copy; 2026 Trackify Workspace Layer.</p>
            <p class="font-medium">System Version: v2.1.0-prod</p>
        </footer>
    </div>

    <script src="/js/toggle_nav.js"></script>
</body>
</html>