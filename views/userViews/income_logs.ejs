<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trackify - Income Logs</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --color-bg-light: #f8fafc;
            --color-bg-card: #ffffff;
            --color-primary: #10b981;
            --color-secondary: #4f46e5;
            --color-text-main: #0f172a;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: var(--color-bg-light);
            color: var(--color-text-main);
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="h-screen flex overflow-hidden bg-slate-50">

    <!-- SIDEBAR COMPONENT LINK -->
    <%- include('../snippets/navbar.ejs') %>
    
    <div class="flex-grow flex flex-col h-full overflow-hidden">
        
        <!-- GLOBAL TOPBAR LINK -->
        <%- include('../snippets/topbar.ejs') %>

        <!-- MAIN APP FRAME CONTAINER -->
        <main class="flex-grow p-6 overflow-y-auto custom-scrollbar space-y-6">
            
            <!-- CONTROLS & UTILITY TOOLBAR -->
            <section class="bg-white border border-slate-200/80 rounded-xl p-4 shadow-sm flex flex-col sm:flex-row gap-3 items-center justify-between">
                <div class="relative w-full sm:w-72">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <i class="fa-solid fa-magnifying-glass text-xs"></i>
                    </span>
                    <input type="text" id="income-search-input" placeholder="Search source or category..." class="w-full pl-9 pr-4 py-2 border border-slate-200 rounded-lg text-xs font-medium text-slate-700 bg-slate-50/50 focus:outline-hidden focus:border-emerald-500/50 focus:bg-white transition-all">
                </div>

                <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
                    <select id="income-category-filter" class="px-3 py-2 border border-slate-200 rounded-lg text-xs font-bold text-slate-600 bg-slate-50/50 focus:outline-hidden cursor-pointer">
                        <option value="ALL">All Categories</option>
                        <option value="Freelance">Freelance Dev</option>
                        <option value="SaaS Platform">SaaS Revenue</option>
                        <option value="Stipend">Academic Stipend</option>
                    </select>

                    <button onclick="openNewTransactionModal()" class="bg-[#10b981] hover:bg-[#059669] text-white text-xs font-bold px-4 py-2 rounded-lg transition-all flex items-center gap-1.5 shadow-xs shrink-0 cursor-pointer">
                        <i class="fa-solid fa-circle-plus"></i> Add Income
                    </button>
                </div>
            </section>

            <!-- DATA TABLE COMPONENT -->
            <section class="bg-white border border-slate-200/80 rounded-xl shadow-sm overflow-hidden flex flex-col">
                <div class="px-5 py-4 border-b border-slate-100">
                    <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wide">Historical Income Records</h3>
                    <p class="text-[11px] text-slate-400">Verified cash inflows logged into core system</p>
                </div>

                <div class="overflow-x-auto custom-scrollbar">
                  <table class="w-full text-left border-collapse">
    <thead>
        <tr class="border-b border-slate-100 bg-slate-50/70 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
            <th class="py-3 px-5">Source / Client</th>
            <th class="py-3 px-5">Category</th>
            <th class="py-3 px-5">Date Statement</th>
            <th class="py-3 px-5 text-right">Amount</th>
            <th class="py-3 px-5 text-center">Receipt</th>
        </tr>
    </thead>
   <tbody id="income-table-body" class="divide-y divide-slate-100 text-xs text-slate-700">
    <tr class="income-row hover:bg-slate-50/50 transition-colors" data-category="Freelance">
        <td class="py-3.5 px-5 font-bold text-slate-800">LiteAcad Portal Contract</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-indigo-50 text-indigo-600 rounded-md font-semibold text-[10px]">Freelance</span>
        </td>
        <td class="py-3.5 px-5 text-slate-400 font-medium">June 28, 2026</td>
        <td class="py-3.5 px-5 text-right font-extrabold text-emerald-500">+₦120,000.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="/income/receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
    <tr class="income-row hover:bg-slate-50/50 transition-colors" data-category="SaaS Platform">
        <td class="py-3.5 px-5 font-bold text-slate-800">TegraLink WhatsApp Subscriptions</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-emerald-50 text-emerald-600 rounded-md font-semibold text-[10px]">SaaS Platform</span>
        </td>
        <td class="py-3.5 px-5 text-slate-400 font-medium">July 01, 2026</td>
        <td class="py-3.5 px-5 text-right font-extrabold text-emerald-500">+₦45,500.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="/income/receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
    <tr class="income-row hover:bg-slate-50/50 transition-colors" data-category="Stipend">
        <td class="py-3.5 px-5 font-bold text-slate-800">Research Grant Clearing</td>
        <td class="py-3.5 px-5">
            <span class="px-2 py-0.5 bg-amber-50 text-amber-600 rounded-md font-semibold text-[10px]">Stipend</span>
        </td>
        <td class="py-3.5 px-5 text-slate-400 font-medium">June 15, 2026</td>
        <td class="py-3.5 px-5 text-right font-extrabold text-emerald-500">+₦15,000.00</td>
        <td class="py-3.5 px-5 text-center">
            <a href="/income/receipt" class="inline-block text-[11px] font-bold bg-[#10b981] text-white px-2.5 py-1 rounded transition-all">
                View
            </a>
        </td>
    </tr>
</tbody>
</table>
                </div>

                <!-- Empty State Message UI Box -->
                <div id="empty-state-fallback" class="hidden py-12 text-center text-slate-400 text-xs font-medium">
                    <i class="fa-solid fa-folder-open text-xl mb-2 text-slate-300 block"></i>
                    No ledger entries match the current filter state.
                </div>
            </section>
        </main>

        <!-- GLOBAL SYSTEM FOOTER -->
        <footer class="h-10 border-t border-slate-200/80 bg-white px-6 flex items-center justify-between text-slate-400 text-[10px] shrink-0">
            <p>&copy; <%= new Date().getFullYear() %> Trackify Workspace Layer.</p>
            <p class="font-medium">System Version: v2.1.0-prod</p>
        </footer>
    </div>

    <!-- REUSABLE INLINE SCRIPTS FOR SEARCH AND MODAL BOUNDARIES -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const searchInput = document.getElementById("income-search-input");
            const filterSelect = document.getElementById("income-category-filter");
            const rows = document.querySelectorAll(".income-row");
            const fallbackElement = document.getElementById("empty-state-fallback");

            function runFilterEngine() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                const selectedCategory = filterSelect.value;
                let matchesFound = 0;

                rows.forEach(row => {
                    const cellText = row.cells[0].textContent.toLowerCase();
                    const rowCategory = row.getAttribute("data-category");

                    const searchMatches = cellText.includes(searchTerm);
                    const categoryMatches = (selectedCategory === "ALL" || rowCategory === selectedCategory);

                    if (searchMatches && categoryMatches) {
                        row.style.display = "";
                        matchesFound++;
                    } else {
                        row.style.display = "none";
                    }
                });

                if (matchesFound === 0) {
                    fallbackElement.classList.remove("hidden");
                } else {
                    fallbackElement.classList.add("hidden");
                }
            }

            searchInput.addEventListener("input", runFilterEngine);
            filterSelect.addEventListener("change", runFilterEngine);
        });

        function openNewTransactionModal() {
            // Emits action verification trigger framework to global stack
            alert('Add Income Action Context Triggered.');
        }
    </script>
    <script src="/js/toggle_nav.js"></script>
</body>
</html>