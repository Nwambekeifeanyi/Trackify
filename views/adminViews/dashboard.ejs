        :root { --primary: #008080; --secondary: #ffbf00; }
        .bg-primary { background-color: var(--primary); }
        .text-primary { color: var(--primary); }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        /* Sidebar Glassmorphism & Transition */
        .sidebar-transition { transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        
        .sidebar-link {
            transition: all 0.2s ease;
            border-left: 4px solid transparent;
        }
        .sidebar-link:hover { background: rgba(255, 255, 255, 0.1); }
        .sidebar-link.active {
            background: rgba(255, 255, 255, 0.2);
            border-left: 4px solid var(--secondary);
        }

        /* Custom Vertical Scrollbar for Sidebar */
        .custom-sidebar-scroll::-webkit-scrollbar {
            width: 5px;
        }
        .custom-sidebar-scroll::-webkit-scrollbar-track {
            background: rgba(0, 0, 0, 0.05);
            border-radius: 10px;
        }
        .custom-sidebar-scroll::-webkit-scrollbar-thumb {
            background: rgba(255, 191, 0, 0.3);
            border-radius: 10px;
            transition: all 0.3s;
        }
        .custom-sidebar-scroll::-webkit-scrollbar-thumb:hover {
            background: var(--secondary);
        }

        /* Dropdown Animation */
        .dropdown-animate {
            transform-origin: top right;
            transition: all 0.2s scale;
        }
        .hidden-dropdown { opacity: 0; transform: scale(0.95); pointer-events: none; }
        .show-dropdown { opacity: 1; transform: scale(1); pointer-events: auto; }
    </style>
