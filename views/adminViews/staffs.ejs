    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/50 z-40 hidden lg:hidden"></div>

    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        AOS.init({ duration: 800, once: true });
        lucide.createIcons();

        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        function toggleSidebar() {
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        const dropdown = document.getElementById('profileDropdown');
        function toggleDropdown() {
            dropdown.classList.toggle('hidden-dropdown');
            dropdown.classList.toggle('show-dropdown');
        }

        window.onclick = function(event) {
            if (!event.target.closest('#profileDropdown') && !event.target.closest('button[onclick="toggleDropdown()"]')) {
                dropdown.classList.add('hidden-dropdown');
                dropdown.classList.remove('show-dropdown');
            }
        }
    </script>



<script>
    // Staff Search Functionality
    const searchInput = document.getElementById('staffSearch');
    const staffRows = document.querySelectorAll('.staff-row');

    searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();

        staffRows.forEach(row => {
            const email = row.querySelector('p.text-gray-400').textContent.toLowerCase();
            const idNumber = row.querySelector('.font-mono').textContent.toLowerCase();
            const role = row.querySelector('.role-tag').textContent.toLowerCase();
            const name = row.querySelector('p.font-black').textContent.toLowerCase();

            if (email.includes(term) || idNumber.includes(term) || role.includes(term) || name.includes(term)) {
                row.style.display = "";
            } else {
                row.style.display = "none";
            }
        });
    });
</script>
